  "repository": { "type": "git", "url": "git+https://github.com/livejiaquan/taiwan-life-data.git", "directory": "packages/mcp-server" },
  "homepage": "https://github.com/livejiaquan/taiwan-life-data/tree/main/packages/mcp-server#readme",
  "bugs": "https://github.com/livejiaquan/taiwan-life-data/issues",
  "keywords": ["mcp", "model-context-protocol", "taiwan", "open-data", "weather", "air-quality", "aqi", "uv", "heat", "carbon-intensity", "reservoir", "台灣", "開放資料"],
  "scripts": {
    "build": "node build.mjs",
